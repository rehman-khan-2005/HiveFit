# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Midknight100!
DB_NAME=hivefit

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Job data ----
# JOBS_PROVIDER: comma-separated, in priority order. Live sources are merged
# and de-duplicated, and one being down degrades the results, not the request.
#   fixtures  offline sample set, no keys, never changes
#   adzuna    aggregates the major boards (incl. Indeed/LinkedIn-sourced posts)
#   muse      needs no key at all, but as of Oct 2026 every listing its public
#             API returns 404s on themuse.com itself — verified with a browser
#             user-agent and no headers at all, and their company pages 404
#             too. The client still works; the data does not. Leave it off
#             until that changes.
# Indeed and LinkedIn have no public job-search API — Indeed closed its
# Publisher API to new applicants and LinkedIn's is partner-only.
JOBS_PROVIDER=fixtures, adzuna
# JOBS_PROVIDER=adzuna

# Hours a posting survives without being seen in a sweep before it is treated
# as delisted. Generous on purpose: boards drop and re-list constantly.
JOBS_TTL_HOURS=168
# What `npm run jobs:refresh` sweeps when given no arguments.
JOBS_REFRESH_QUERIES=software engineer,data analyst,machine learning,devops,full stack developer

# api.adzuna.com/v1/api — free tier is 25,000 calls/month
ADZUNA_APP_ID=f5dfcf8b
ADZUNA_APP_KEY=
263aba367495a610655daf5b6d84385b
ADZUNA_COUNTRY=us

# themuse.com/developers/api/v2 — optional, raises the rate limit
MUSE_API_KEY=


# ---- AI suggestions ----
# AI_PROVIDER: "heuristic" (no keys, deterministic) or "anthropic" (live)
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
