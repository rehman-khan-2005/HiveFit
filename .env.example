# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Midknight100!
DB_NAME=hivefit

# ---- Auth ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- Job data ----
# JOBS_PROVIDER: "fixtures" (no keys needed) or "adzuna" (live)
JOBS_PROVIDER=fixtures
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# ---- AI suggestions ----
# AI_PROVIDER: "heuristic" (no keys, deterministic) or "anthropic" (live)
AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
