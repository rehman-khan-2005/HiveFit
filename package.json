{
  "name": "hivefit",
  "version": "0.1.0",
  "private": true,
  "description": "HiveFit - an intelligent resume optimization and job-matching platform",
  "workspaces": [
    "server",
    "mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "db:setup": "npm run db:setup --workspace=server",
    "db:seed": "npm run db:seed --workspace=server",
    "test": "npm run test --workspace=server",
    "mobile": "npm run start --workspace=mobile",
    "smoke": "node server/tests/smoke.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
